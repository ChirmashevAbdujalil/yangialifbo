<?xml version="1.0" encoding="UTF-8"?>
<!--
  Yangi Alifbo — Microsoft Word qo'shimchasi (Office Add-in) manifesti.
  Sayt manzili o'zgarsa, quyidagi barcha "https://yangialifbouz.vercel.app" manzillarini almashtiring
  va <Version> raqamini oshiring.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>a8f8b438-1307-4c0f-9270-ae67fdfc5347</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Abdujalil Chirmashev</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Yangi Alifbo"/>
  <Description DefaultValue="Word hujjatlarini kirill, lotin va yangi alifbo oʻrtasida oʻgirish. Shrift, jadval va rasmlar oʻzgarmaydi."/>
  <IconUrl DefaultValue="https://yangialifbouz.vercel.app/word-addin/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://yangialifbouz.vercel.app/word-addin/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://yangialifbouz.vercel.app/"/>
  <AppDomains>
    <AppDomain>https://yangialifbouz.vercel.app</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://yangialifbouz.vercel.app/word-addin/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="YangiAlifbo.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="YangiAlifbo.TaskpaneButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>YangiAlifboPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://yangialifbouz.vercel.app/word-addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://yangialifbouz.vercel.app/word-addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://yangialifbouz.vercel.app/word-addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://yangialifbouz.vercel.app/word-addin/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://yangialifbouz.vercel.app/word-addin/taskpane.html"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://yangialifbouz.vercel.app/"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Yangi Alifbo qoʻshimchasi oʻrnatildi"/>
        <bt:String id="Group.Label" DefaultValue="Yangi Alifbo"/>
        <bt:String id="Button.Label" DefaultValue="Yangi Alifbo"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="«Bosh sahifa» (Home) boʻlimidagi «Yangi Alifbo» tugmasini bosing — konvertor paneli ochiladi."/>
        <bt:String id="Button.Tooltip" DefaultValue="Hujjatni kirill, lotin va yangi alifbo oʻrtasida oʻgirish. Formatlash oʻzgarmaydi."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
